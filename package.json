{
  "name": "nextapp-autoparts-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/Nexapp-CRM",
    "dev:mobile": "npm run start --workspace=apps/Nextapp-Mobile",
    "dev:api": "npm run dev --workspace=apps/Nextapp-API",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}