{
  "name": "nextapp-autoparts-platform",
  "private": true,
  "workspaces": [
    "apps/NextApp-CRM",
    "apps/NextApp-API",
    "apps/NextApp-Mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/NextApp-CRM",
    "dev:mobile": "npm run start --workspace=apps/NextApp-Mobile",
    "dev:api": "npm run dev --workspace=apps/NextApp-API",
    "dev:all": "concurrently --names API,WEB,MOBILE --prefix-colors red,blue,green \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}